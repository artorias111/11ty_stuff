<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>{% if title and title != "Home" %}{{ title | plain }} · TTAGGC{% else %}TTAGGC{% endif %}</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  {#- Masthead is a two-row grid: wordmark and bio share the top row, the nav
      spans the full width underneath. The nav is wider than the wordmark, so
      it cannot share a row without squeezing the bio into a sliver. -#}
  <header class="masthead">
    <a class="logo" href="/"><img src="/images/logo.svg" alt="TTAGGC"></a>

    {#- Bio shows only on the homepage — repeating it above every post would
        bury the post. Text lives in _data/site.json. -#}
    {%- if page.url == "/" %}
    <p class="intro">{{ site.intro }}</p>
    {%- endif %}

    {# Nav lives in _data/nav.json. An item with no `art` just renders as text,
       so a drawing can be swapped in or dropped one at a time. #}
    <nav>
      <ul>
      {%- for item in nav %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>
          {%- if item.art %}<img class="icon" src="{{ item.art }}" alt="">{% endif %}{{ item.label }}</a></li>
      {%- endfor %}
      </ul>
    </nav>
  </header>

  <main>
    {#- Dated entries show when they were written; living pages (tech stack,
        lab space) show when they were last revised instead. -#}
    {%- if tags and ("post" in tags or "note" in tags) %}
    <p class="entry-date"><time datetime="{{ page.date | isoDate }}">{{ page.date | isoDate }}</time></p>
    {%- elif updated %}
    <p class="entry-date">last updated <time datetime="{{ updated | isoDate }}">{{ updated | isoDate }}</time></p>
    {%- endif %}
    {{ content | safe }}
  </main>

  <script>
    // Adds a copy button to every code block. Purely additive: with JS off you
    // still get highlighted, selectable code — just no button.
    document.querySelectorAll("pre[class*='language-']").forEach(function (pre) {
      var code = pre.querySelector("code");
      if (!code) return;

      var wrap = document.createElement("div");
      wrap.className = "code-block";
      pre.parentNode.insertBefore(wrap, pre);
      wrap.appendChild(pre);

      var btn = document.createElement("button");
      btn.className = "copy";
      btn.type = "button";
      btn.textContent = "copy";
      // The button is a sibling of <pre>, not inside it, so it can never end
      // up in the copied text or in a manual selection.
      wrap.appendChild(btn);

      btn.addEventListener("click", function () {
        navigator.clipboard.writeText(code.textContent).then(function () {
          btn.textContent = "copied";
          setTimeout(function () { btn.textContent = "copy"; }, 1200);
        });
      });
    });
  </script>
</body>
</html>
