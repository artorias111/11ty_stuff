<h1>Food</h1>

<p>Things I cooked and would cook again.</p>

<ul class="entries">
{%- for entry in collections.food | reverse %}
  <li>
    <a href="{{ entry.url }}">{{ (entry.data.title or entry.fileSlug) | emphasis | safe }}</a>
    <time datetime="{{ entry.date | isoDate }}">{{ entry.date | isoDate }}</time>
  </li>
{%- endfor %}
</ul>
