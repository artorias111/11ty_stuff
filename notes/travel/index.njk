---
title: Travel
eleventyExcludeFromCollections: true
---

<h1>Travel</h1>

<p>Places I went.</p>

<ul class="entries">
{%- for entry in collections.travel | reverse %}
  <li>
    <a href="{{ entry.url }}">{{ entry.data.title or entry.fileSlug }}</a>
    <time datetime="{{ entry.date | isoDate }}">{{ entry.date | isoDate }}</time>
  </li>
{%- endfor %}
</ul>
