---
layout: default
title: Home
---

<img src="/images/lymphocytes_2x.png" alt="xkcd 2749: Lymphocytes" width="45%"/>

<h2>Posts</h2>

<ul class="entries">
{%- for post in collections.post | reverse %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title or post.fileSlug }}</a>
    <time datetime="{{ post.date | isoDate }}">{{ post.date | isoDate }}</time>
  </li>
{%- endfor %}
</ul>
